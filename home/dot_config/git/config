# Linked as the ~/.config/git folder (see Scripts/Tools.ps1), so relative include paths below resolve
# inside this folder. Settings for one context go in a file of their own, included by a condition.
[user]
	email = git@adriangaborek.dev
	name = Adrian Gaborek
[core]
	fsmonitor = true
	untrackedCache = true
	longpaths = true
[checkout]
	workers = 0
[difftool]
	prompt = false
[mergetool]
	prompt = false
	keepBackup = false
[fetch]
	prune = true
	pruneTags = false
# Work repositories, recognised by their remote - on any machine, and already while cloning one
[includeIf "hasconfig:remote.*.url:https://git.devnet.de/**"]
	path = work
