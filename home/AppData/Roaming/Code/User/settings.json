{
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.tabSize": 2,
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.activeIconPacks": [
    "angular"
  ],
  "editor.fontFamily": "JetBrainsMono Nerd Font, Consolas, 'Courier New', monospace",
  "files.watcherExclude": {
    "**/.angular/**": true,
    "**/.git/**": true,
    "**/.vs/**": true,
    "**/bin/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/obj/**": true,
    "**/out-tsc/**": true
  },
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.cursorSmoothCaretAnimation": "on",
  "vscode_custom_css.imports": [
    "file://${userHome}/.config/vscode/custom.css",
    "file://${userHome}/.config/vscode/custom.js"
  ],
  "workbench.colorCustomizations": {},
  "workbench.settings.applyToAllProfiles": [],
  "window.titleBarStyle": "custom",
  "vscode_vibrancy.opacity": 0.5,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.foldingImportsByDefault": true,
  "editor.guides.bracketPairs": "active",
  "editor.linkedEditing": true,
  "editor.smoothScrolling": true,
  "editor.fontLigatures": true,
  "editor.inlineSuggest.syntaxHighlightingEnabled": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "workbench.commandPalette.experimental.suggestCommands": true,
  "workbench.list.smoothScrolling": true,
  "workbench.reduceMotion": "off",
  "workbench.view.showQuietly": {
    "workbench.panel.output": true
  },
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "window.menuBarVisibility": "compact",
  "explorer.fileNesting.enabled": true,
  "debug.autoExpandLazyVariables": "on",
  "debug.showVariableTypes": true,
  "telemetry.telemetryLevel": "off",
  "editor.minimap.autohide": "mouseover",
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "update.mode": "default",
  "git.autofetch": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  "sqldeveloper.sqlHistory.historyLimit": 500,
  "sqldeveloper.telemetry.enabled": false,
  // mssql.connections and their connection groups: work-only, in the encrypted work overlay (~/work.code-workspace) - see the pre-commit hook.
  "mssql.copyIncludeHeaders": true,
  "mssql.enableExperimentalFeatures": true,
  "mssql.format.alignColumnDefinitionsInColumns": true,
  "mssql.format.keywordCasing": "uppercase",
  "mssql.ignorePlatformWarning": true,
  "mssql.objectExplorer.groupBySchema": true,
  "mssql.openQueryResultsInTabByDefault": true,
  "mssql.query.alwaysEncryptedParameterization": true,
  "debug.openDebug": "openOnDebugBreak",
  "editor.tabCompletion": "off",
  "powershell.integratedConsole.focusConsoleOnExecute": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "powershell.codeFolding.showLastLine": true,
  "powershell.sideBar.CommandExplorerVisibility": true,
  "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
  "powershell.codeFormatting.whitespaceBetweenParameters": true,
  "powershell.integratedConsole.showOnStartup": false,
  "git.openRepositoryInParentFolders": "always",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.enableImages": true,
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.experimental.windowsUseConptyDll": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.smoothScrolling": true,
  "application.shellEnvironmentResolutionTimeout": 60,
  "security.workspace.trust.enabled": true,
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "editor.mouseWheelZoom": true,
  "editor.codeLensFontFamily": "JetBrainsMono Nerd Font, Consolas, 'Courier New', monospace",
  "editor.inlayHints.fontFamily": "JetBrainsMono Nerd Font, Consolas, 'Courier New', monospace",
  "diffEditor.experimental.showMoves": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "mdb.mcp.server": "prompt",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "terminal.integrated.stickyScroll.enabled": false,
  "sqldeveloper.datagrid.fontFamily": "Consolas, 'Courier New', monospace",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.selectedModel": "default",
  "claudeCode.useCtrlEnterToSend": true,
  "mssql.enableQueryHistoryCapture": true,
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.dockercompose",
  "claudeCode.focusView": false,
  "chat.mcp.gallery.enabled": true,
  "workbench.experimental.modernUI": true,
  // Hides chat, inline suggestions and the other built-in AI features, and turns the Copilot extensions off.
  // Claude Code is its own extension and keeps working.
  "chat.disableAIFeatures": true,
  "claudeCode.hideOnboarding": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 3,
  "editor.formatOnPaste": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.hideUnchangedRegions.minimumLineCount": 5,
  "diffEditor.wordWrap": "on",
  "multiDiffEditor.experimental.variant": "cards",
  "editor.minimap.renderCharacters": false,
  "editor.minimap.size": "fit",
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggest.insertMode": "replace",
  "editor.suggest.localityBonus": true,
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.wordBasedSuggestions": "matchingDocuments",
  "files.autoGuessEncoding": true,
  "files.autoSaveWorkspaceFilesOnly": true,
  "files.candidateGuessEncodings": [
    "utf8",
    "windows1252"
  ],
  "files.defaultLanguage": "${activeEditorLanguage}",
  "files.dialog.defaultPath": "D:\\Source",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.jj": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true,
    "**/.angular": true
  },
  "files.hotExit": "onExitAndWindowClose",
  "files.readonlyFromPermissions": true,
  "files.readonlyInclude": {
    "**/node_modules/**": true,
    "**/package-lock.json": true
  },
  "files.trimTrailingWhitespaceInRegexAndStrings": false,
  "workbench.activityBar.compact": true,
  "workbench.sideBar.location": "right",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.view.alwaysShowHeaderActions": true,
  "breadcrumbs.enabled": false,
  "workbench.editor.autoLockGroups": {
    "workbench.editorinputs.searchEditorInput": true,
    "workbench.editor.browser": true,
    "mainThreadWebview-markdown.preview": true,
    "mssql.executionPlanView": true
  },
  "workbench.editor.customLabels.patterns": {
    "**/Program.cs": "${dirname} · Program.cs",
    "**/appsettings*.json": "${dirname} · ${filename}.${extname}",
    "**/*.csproj": "${filename}.csproj",
    "**/index.ts": "${dirname} · index.ts"
  },
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.sharedViewState": true,
  "workbench.editor.showTabIndex": true,
  "workbench.editor.titleScrollbarSizing": "large",
  "workbench.editor.wrapTabs": true,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.settings.showAISearchToggle": false,
  "zenMode.centerLayout": false,
  "zenMode.restore": false,
  "screencastMode.keyboardOptions": {
    "showSingleEditorCursorMoves": false
  },
  "screencastMode.keyboardOverlayTimeout": 1500,
  "workbench.browser.searchEngine": "google",
  "workbench.browser.enableChatTools": false,
  "window.density.editorTabHeight": "compact",
  "window.density.layout": "compact",
  "window.title": "${rootNameShort}${separator}${activeRepositoryBranchName}${separator}${activeEditorShort}${separator}${profileName}",
  "window.titleSeparator": " · ",
  "window.newWindowDimensions": "inherit",
  "window.openFoldersInNewWindow": "on",
  "chat.agent.enabled": false,
  "accessibility.dimUnfocused.enabled": true,
  "accessibility.dimUnfocused.opacity": 0.85,
  "explorer.copyRelativePathSeparator": "/",
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.json": "${capture}.*.json",
    "*.ts": "${capture}.js, ${capture}.html, ${capture}.scss, ${capture}.css, ${capture}.spec.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock, .npmrc, .nvmrc, .browserslistrc, .prettierrc*, .prettierignore, eslint.config.*, .eslintrc*",
    "*.csproj": "${capture}.csproj.user, packages.lock.json",
    "*.sln": "*.slnx, Directory.Build.props, Directory.Build.targets, Directory.Packages.props, global.json, nuget.config, .editorconfig",
    "*.slnx": "Directory.Build.props, Directory.Build.targets, Directory.Packages.props, global.json, nuget.config, .editorconfig",
    ".gitignore": ".gitattributes",
    "docker-compose.yml": "docker-compose.*.yml, .dockerignore",
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json, ${capture}.*.cs"
  },
  "explorer.incrementalNaming": "smart",
  "explorer.openEditors.visible": 10,
  "search.seedWithNearestWord": true,
  "search.showLineNumbers": true,
  "search.smartCase": true,
  "debug.breakpointsView.presentation": "tree",
  "debug.closeReadonlyTabsOnEnd": true,
  "debug.onTaskErrors": "showErrors",
  "debug.openExplorerOnEnd": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.terminal.clearBeforeReusing": true,
  "debug.toolBarLocation": "commandCenter",
  "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
  "testing.automaticallyOpenTestResults": "openOnTestFailure",
  "scm.alwaysShowActions": true,
  "scm.diffDecorationsGutterWidth": 4,
  "scm.diffDecorationsIgnoreTrimWhitespace": "inherit",
  "scm.inputFontFamily": "editor",
  "scm.inputMinLineCount": 3,
  "scm.workingSets.enabled": true,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "extensions.allowOpenInModalEditor": true,
  "terminal.external.windowsExec": "wt.exe",
  "terminal.integrated.autoReplies": {
    "Terminate batch job (Y/N)": "Y\r"
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.hideOnStartup": "whenEmpty",
  "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
  "terminal.integrated.tabs.focusMode": "singleClick",
  "terminal.integrated.tabs.showActions": "always",
  "terminal.integrated.tabs.title": "${process}${separator}${shellCommand}",
  "task.problemMatchers.neverPrompt": true,
  "problems.showCurrentInStatus": true,
  "telemetry.feedback.enabled": false,
  "workbench.cloudChanges.autoResume": "off",
  "workbench.cloudChanges.continueOn": "off",
  "workbench.enableExperiments": false,
  "workbench.externalBrowser": "C:\\Program Files\\Firefox Developer Edition\\firefox.exe",
  "workbench.layoutControl.enabled": false,
  "workbench.list.defaultFindMode": "filter",
  "workbench.localHistory.maxFileEntries": 100,
  "workbench.localHistory.mergeWindow": 60,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "workbench.commandPalette.experimental.enableNaturalLanguageSearch": false,
  "workbench.commandPalette.showAskInChat": false,
  "editor.autoIndentOnPaste": true,
  "editor.autoIndentOnPasteWithinString": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.copyWithSyntaxHighlighting": false,
  "editor.mouseMiddleClickAction": "ctrlLeftClick",
  "editor.renderFinalNewline": "dimmed",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.scrollOnMiddleClick": true,
  "editor.experimentalGpuAcceleration": "on",
  "editor.experimental.preferTreeSitter.typescript": true,
  "editor.experimental.preferTreeSitter.css": true,
  "claudeCode.enableNewConversationShortcut": true,
  "csharp.experimental.debug.hotReload": true,
  "dotnet.automaticallySyncWithActiveItem": true,
  "dotnet.preferVisualStudioCodeFileSystemWatcher": true,
  "dotnet.suppressSdkInstallView": false,
  "dotnet.testWindow.enableTestExplorerDiff": true,
  "dotnet.copilot.enableDotnetSkills": false,
  "dotnet.projectsystem.useNewMemoryOptimization": true,
  "dotnet.testWindow.discoverTestsFromSource": true,
  "dotnet.enablePublishIssuesToProblems": false,
  "projects.defaultProjectSaveLocation": "D:\\Source",
  "vscode_vibrancy.preferredDarkTheme": "Custom theme (use imports)",
  "window.controlsStyle": "custom",
  "synthwave84.brightness": 0.25
}
