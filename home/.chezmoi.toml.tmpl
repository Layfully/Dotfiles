{{- /*
  chezmoi's per-machine config (~/.config/chezmoi/chezmoi.toml), generated by `chezmoi init`.

  role: "private" is the default setup (the private machine's); "work" adds the encrypted work overlay
  (see .chezmoiignore). Machines named WORK-PC start out as work. Once written, a machine keeps its
  role and its answers below across `chezmoi init` runs - change them with `chezmoi edit-config`.
*/ -}}
{{- $role := "private" -}}
{{- if hasKey . "role" -}}
{{-   $role = .role -}}
{{- else if hasPrefix "WORK-PC-" (lower .chezmoi.hostname) -}}
{{-   $role = "work" -}}
{{- end -}}
{{- /* Optional Windows components; WSL doesn't use them, so it isn't asked */ -}}
{{- $gitHubCli := false -}}{{- $node := false -}}{{- $claudeCode := false -}}{{- $az := false -}}{{- $rider := false -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $gitHubCli = promptBoolOnce . "gitHubCli" "Install the GitHub CLI" -}}
{{-   $node = promptBoolOnce . "node" "Install Node.js LTS through nvm" -}}
{{-   $claudeCode = promptBoolOnce . "claudeCode" "Install the Claude Code CLI" -}}
{{-   $az = promptBoolOnce . "az" "Install the Az PowerShell modules" -}}
{{-   $rider = promptBoolOnce . "rider" "Install JetBrains Rider" -}}
{{- end -}}
# Generated by `chezmoi init` from home/.chezmoi.toml.tmpl in the dotfiles repo. The [data] values are
# kept when it is generated again; anything else changed here is not.
sourceDir = {{ .chezmoi.workingTree | quote }}
{{ if eq .chezmoi.os "windows" -}}
# Plain files become symlinks into the repo, so settings the apps change themselves land in git
mode = "symlink"
{{- else -}}
# WSL: plain files are copies. Links would point into the Windows clone under /mnt/c, and reading a file there
# is slow: every git command (and so every prompt) read its config across it. Nothing in WSL writes these.
mode = "file"
{{- end }}
encryption = "age"

[age]
    # The repo holds this key only encrypted with a passphrase (Config/age/key.txt.age; Bootstrap.ps1 decrypts it)
    identity = {{ joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" | quote }}
    recipient = "age15x89lljxjpa6tlxj5sy32cspsz20qm3rxt83tpm022gvgayq49ns3j8wg5"

[interpreters.ps1]
    # -NoProfile: the setup scripts must not depend on (or wait for) the profile they set up
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile", "-File"]

[data]
    role = {{ $role | quote }}
    gitHubCli = {{ $gitHubCli }}
    node = {{ $node }}
    claudeCode = {{ $claudeCode }}
    az = {{ $az }}
    rider = {{ $rider }}
