{{ if and (eq .chezmoi.os "windows") (and (hasKey . "devDrive") .devDrive) -}}
# Runs again when the Dev Drive (chezmoi edit-config) or the script changes; machines without one skip it:
# script: {{ include (joinPath .chezmoi.workingTree "Scripts/Setup/Set-DevDriveCaches.ps1") | sha256sum }}
& {{ joinPath .chezmoi.workingTree "Scripts/Setup/Set-DevDriveCaches.ps1" | squote }} -DevDrive {{ .devDrive }}
exit $LASTEXITCODE
{{ end -}}
