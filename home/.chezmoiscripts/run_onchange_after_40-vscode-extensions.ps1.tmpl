# Runs again whenever an extension list this machine uses changes:
# base: {{ include (joinPath .chezmoi.workingTree "Config/VisualStudioCode/extensions") | sha256sum }}
{{- $workExtensions := joinPath .chezmoi.workingTree "Config/VisualStudioCode/extensions.work" }}
{{- if and (eq .role "work") (stat $workExtensions) }}
# work: {{ include $workExtensions | sha256sum }}
{{- end }}
& {{ joinPath .chezmoi.workingTree "Scripts/Setup/Install-VsCodeExtensions.ps1" | squote }} -Role {{ .role }}
exit $LASTEXITCODE
