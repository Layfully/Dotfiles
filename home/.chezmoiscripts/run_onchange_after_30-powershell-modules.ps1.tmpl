{{ if eq .chezmoi.os "windows" -}}
# Runs again when the module list (in the script) or -Az changes, and once a week: UniGetUI installs module
# updates next to the old versions, and the script removes those.
# script: {{ include (joinPath .chezmoi.workingTree "Scripts/Setup/Install-PowerShellModules.ps1") | sha256sum }}
# week: {{ div (now).Unix 604800 }}
& {{ joinPath .chezmoi.workingTree "Scripts/Setup/Install-PowerShellModules.ps1" | squote }} -Az:${{ .az }}
exit $LASTEXITCODE
{{ end -}}
