# Runs again whenever a package list or an optional component (chezmoi edit-config) changes:
# base packages: {{ include (joinPath .chezmoi.workingTree "Config/WinGet/configuration.dsc.yaml") | sha256sum }}
{{- $workPackages := joinPath .chezmoi.workingTree "Config/WinGet/configuration.work.dsc.yaml" }}
{{- if and (eq .role "work") (stat $workPackages) }}
# work packages: {{ include $workPackages | sha256sum }}
{{- end }}
& {{ joinPath .chezmoi.workingTree "Scripts/Setup/Install-Packages.ps1" | squote }} -Role {{ .role }} -GitHubCli:${{ .gitHubCli }} -Node:${{ .node }} -ClaudeCode:${{ .claudeCode }}
exit $LASTEXITCODE
