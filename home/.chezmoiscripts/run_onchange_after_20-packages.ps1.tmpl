{{ if eq .chezmoi.os "windows" -}}
# Runs again whenever a package list this machine uses or the script changes:
# script: {{ include (joinPath .chezmoi.workingTree "Scripts/Setup/Install-Packages.ps1") | sha256sum }}
# base packages: {{ include (joinPath .chezmoi.workingTree "Config/WinGet/configuration.dsc.yaml") | sha256sum }}
{{- $rolePackages := joinPath .chezmoi.workingTree (printf "Config/WinGet/configuration.%s.dsc.yaml" .role) }}
{{- if stat $rolePackages }}
# {{ .role }} packages: {{ include $rolePackages | sha256sum }}
{{- end }}
{{- if eq .role "work" }}
# Visual Studio components: {{ include (joinPath .chezmoi.workingTree "Config/VisualStudio/work.vsconfig") | sha256sum }}
{{- end }}
try { & {{ joinPath .chezmoi.workingTree "Scripts/Setup/Install-Packages.ps1" | squote }} -Role {{ .role }} } catch { Write-Error $_; exit 1 }
exit $LASTEXITCODE
{{ end -}}
