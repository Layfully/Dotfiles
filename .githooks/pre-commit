#!/bin/sh
# Resolve the repo from git rather than assuming a clone location
repo="$(git rev-parse --show-toplevel)"

# Work database connections belong in the encrypted work overlay, never in the shared VS Code settings. The
# mssql extension saves new ones into those settings, so catch them before they reach the public repo.
vscode_settings="home/AppData/Roaming/Code/User/settings.json"
if git diff --cached --name-only | grep -qxF "$vscode_settings" &&
    git show ":$vscode_settings" | grep -q '"mssql\.connections"'; then
    echo "pre-commit: $vscode_settings contains mssql.connections." >&2
    echo "Move them into ~/work.code-workspace (the work overlay), then: chezmoi add --encrypt ~/work.code-workspace" >&2
    exit 1
fi

powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File "$repo/Scripts/GitHooks/SaveVsCodeExtensions.ps1"

# The private machine writes extensions, work machines extensions.work (see SaveVsCodeExtensions.ps1).
# git add fails, aborting the commit, on a file that doesn't exist yet.
for list in extensions extensions.work; do
    if [ -f "$repo/Config/VisualStudioCode/$list" ]; then
        git add "$repo/Config/VisualStudioCode/$list"
    fi
done
